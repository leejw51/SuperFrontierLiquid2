# SuperFrontierLiquid genesis environment.
#
#   cd rust && make env && make init
#
# Use `make env` rather than copying this file: the gateway's server secret
# must be generated per machine, and `make env` does that. A straight copy
# leaves the placeholder below in place, and the gateway refuses to start with
# it — on purpose.
#
# The node auto-loads a sibling `.env`; real shell variables win over it.
# Referencing a variable in a genesis file that is set nowhere is a hard error,
# which is deliberate: a silently-empty address would produce a chain whose
# funds nobody controls.
#
# Unlike a bare template, every address below is FILLED IN and usable straight
# away, because the first thing anyone does with this project is boot it.
#
# ---------------------------------------------------------------------------
# WHERE THESE ADDRESSES COME FROM
#
# Each is derived with `keypair_from_seed(seed)` from the well-known seed shown
# in the comment beside it. That means anyone can re-derive the matching
# PRIVATE KEY from the seed string. That is the point for a local simulator —
# the demo traders and the oracle have to be drivable by whoever cloned the
# repo — and it is also exactly why none of these may ever be used anywhere
# that holds anything of value.
# The dotenv parser skips a line that STARTS with '#', but it does not strip a
# comment from the end of a value line. So every comment here is on its own
# line. A trailing comment would silently become part of the address.
# ---------------------------------------------------------------------------

# Validator and community wallets. The validator's signing key still comes from
# the `seed` field in the genesis file; `wallet` is only where the initial
# credit lands.
# seed: cb-wallet-0
export MYWALLET0=0x2145df2dab4396569ed57bcbb7d678f2a04a22ad
# seed: cb-wallet-1
export MYWALLET1=0xbdfa3140d4ebc27c679e3d6fe8f5a1df84ca0e50
# seed: cb-wallet-2
export MYWALLET2=0x08483d02773739e790db45020b90e8e1b6332c8c
# seed: cb-wallet-3
export MYWALLET3=0x8da9474095e033bc17369518ff365d99b26eba60

# Oracle authorities. Only these addresses may sign an OracleUpdate for their
# markets. They are separate from the validators so the price feed and the
# consensus signers can be operated independently — and so that compromising
# one does not hand over the other.
# seed: cb-oracle-btc
export ORACLE_BTC=0x79c1bef33668fb267546509399179d3dd98b45da

# The single oracle authority used by genesis-full.jsonl, which lists one
# authority for every market. A production deployment should split this per
# market so that compromising one feed does not compromise them all.
# seed: cb-oracle-btc
export ORACLE_AUTHORITY=0x79c1bef33668fb267546509399179d3dd98b45da
export ORACLE_AUTHORITY_KEY=0x943f7fb2f31e4f9a82252e317c82fb35408191017f64100b7ce1485d21e56730
# seed: cb-oracle-eth
export ORACLE_ETH=0xc771d3eec7c5a9ce19987e8ce5a90c0693bb6ac0

# Demo traders, pre-funded with margin collateral so the books have someone in
# them the moment the chain starts.
# seed: cb-demo-trader-0
export DEMO_TRADER0=0xc17265dec2ce8b1474f299a573d06d9488d2095b
# seed: cb-demo-trader-1
export DEMO_TRADER1=0x4083b5c3ec3504462341b4b77cdacba8fcc2c933
# seed: cb-demo-trader-2
export DEMO_TRADER2=0x47560a7f36b76bae409ba846b7ff3df32d752f7b

# The chain treasury. This is the ONLY account permitted to mint via a Deposit
# transaction, so it is the account the faucet pays out of, and it is the figure
# every conservation check reconciles against.
#
# It must be an address somebody can actually sign for. Earlier genesis files
# used a vanity address with no private key, which meant the faucet could never
# mint anything — the failure only shows up when you click the button.
# seed: cb-treasury
export TREASURY=0xcc2ed4c13d5b46c61a5e35449feecdb902f49b5c

# The matching private key, passed to the gateway as --faucet-treasury-key.
# Published on purpose: this is a local simulator and the faucet has to work out
# of the box. It is also exactly why nothing here may hold anything of value.
export TREASURY_KEY=0xaafb22c3f49da356eee87a04082363e133298e9d9bf3fa47eabec78c2706c43d

# Starting credit per wallet, as a raw integer with no decimal point. The
# on-chain unit is 1/1000 of one CBL, so 1_000_000_000_000 raw is
# 1,000,000,000.000 CBL.
export INITIAL_AMOUNT=1000000000000

# Native denomination. Persisted in chain metadata and shown by the client.
# Display-only: it does not change the on-chain asset enum.
export MYDENOM=CBL

# Chain id, a u32, signed into every transaction so a transaction minted on one
# chain cannot be replayed on another. 1 is mainnet, 2 is testnet, 1000 and up
# are ad-hoc devnets. Changing this requires wiping the data directory
# (`make clean && make init`), because the existing blocks carry the old id.
export MYCHAINID=1000

# Every account's trading key is HKDF(server_secret, login_address), so this
# value decides which on-chain account a login maps to, and anyone who holds it
# can derive every user's trading key from their public login address.
#
# This file is committed, so anything written here is published. The value
# below is therefore a PLACEHOLDER that the gateway refuses by name: it is not
# a secret, and it is not meant to work. `make env` replaces it with 32 random
# bytes when it writes your `.env`.
#
# Changing it later orphans every trading account — the same login address
# derives a different on-chain account, with none of the old one's money.
export GATEWAY_SERVER_SECRET=replace-me-run-make-env

# The login address that holds the operator role, if you want one. The role is
# bound to an address rather than to a handle because an address is held by
# whoever holds its key, while a handle is a self-chosen string the first
# account to log in can claim. Uncomment and set it to your own login address
# (the one `GET /auth/session` shows as `login_address`); `make gateway` will
# pass it as --admin-address.
#
# Left unset, `make gateway` falls back to --admin-handle admin with the
# explicit --insecure-admin-by-handle opt-in, which is fine for a loopback
# simulator and unfit for anything else.
# export GATEWAY_ADMIN_ADDRESS=0x0000000000000000000000000000000000000000
